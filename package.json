{
  "name": "Taxi24-API",
  "version": "1.0.0",
  "description": "Taxi24 is an application that holds a set of APIs that other companies can use to manage their fleet of drivers and allocate drivers to passengers.",
  "main": "app.js",
  "scripts": {
    "start": "node ./bin/run.js",
    "dev": "nodemon ./bin/run.js",
    "test": "jest --runInBand",
    "db:create": "sequelize-cli db:create",
    "migrate": "sequelize-cli db:migrate",
    "db:setup": "npm run db:create && npm run migrate && npm run seed",
    "seed": "sequelize-cli db:seed:all"
  },
  "keywords": [],
  "author": "Christian Uwakristu",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.19.0",
    "dateformat": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^4.17.1",
    "joi": "^17.2.1",
    "morgan": "^1.10.0",
    "pg": "^8.3.3",
    "pg-hstore": "^2.3.3"
  },
  "devDependencies": {
    "jest": "^25.1.0",
    "nodemon": "^2.0.4",
    "sequelize": "^6.37.8",
    "supertest": "^7.3.2"
  }
}
